	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="csucursal" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select ctc.sdescripcioncomercial departamento,count(toes.cexamen) totalestudios,sum(toes.mtotal) total
from t_orden_sucursal tos,t_orden_examen_sucursal toes,c_examen ce,c_tipo_comercial ctc
where tos.kordensucursal=toes.kordensucursal
and toes.cexamen=ce.cexamen
and ce.ctipocomercial=ctc.ctipocomercial
and (tos.dregistro between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tos.cestadoregistro<>17
and tos.csucursal=$P{csucursal}
group by ctc.sdescripcioncomercial order by total]]></queryString>
	<field name="DEPARTAMENTO" class="java.lang.String"/>
	<field name="TOTALESTUDIOS" class="java.lang.Integer"/>
	<field name="TOTAL" class="java.lang.Double"/>
	<variable name="TOTALGENERAL" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL}]]></variableExpression>
	</variable>
	<variable name="TOTALESTUDIOS" class="java.lang.Integer" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTALESTUDIOS}]]></variableExpression>
	</variable>
