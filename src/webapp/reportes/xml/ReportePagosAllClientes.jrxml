	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="objfechafin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechaini" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String"/>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cconvenio" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select   distinct tpf.kpagofactura  indexkadmision,
        tpf.kpagofactura kadmision, 
                                   tpf.dfechapago dcaptura, 
        '' snemunidad, 
                               (nvl(trim(tf.sserie),'') || trim(to_char(nvl(tf.ufoliofactura,0),'00000000'))) korden, 
                               tf.csucursal cunidad,    
                               '' stituloimpresion, 
                               0 mtotal,  
                               tpf.mpago mpago, 
                               tpf.msaldo msaldo, 
                               1 knegociacion, 
                               ctpf.stipopago snegociacion, 
                               tu.login_name usuario, 
                               cc.sconvenio sconvenio,
    tpf.kpagofactura kordenfundacion,    
    0 kpagofundacion
from t_pago_factura tpf 
inner join t_factura tf on tf.kfactura=tpf.kfactura
inner join c_convenio cc on cc.cconvenio= tf.cconvenio
inner join turbine_user tu on tu.user_id= tpf.user_id
inner join c_tipo_pago_factura ctpf on ctpf.ctipopago=tpf.ctipopago
where tpf.cestadoregistro<>53
and tf.cestadoregistro<>34 
and (tpf.dfechapago between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tf.csucursal in (1003, 1012,1013,1014,1015,1017,1020,1021)
group by tpf.kpagofactura, tpf.dfechapago,tf.sserie,tf.ufoliofactura,tf.csucursal,tpf.mpago, tpf.msaldo,tu.login_name,cc.sconvenio,ctpf.stipopago
order by knegociacion,korden,kpagofundacion]]></queryString>
