		<defaultValueExpression ><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="filtro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nombrefiltro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cmarca" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="cusuario" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0) ]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String"/>
	<parameter name="csucursal" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select   distinct tos.kordensucursal  indexkadmision,
        tos.kordensucursal kadmision, 
		    tos.dregistro dcaptura, 
        '' snemunidad, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		'' cunidad,    
		toes.sexamen stituloimpresion, 
		0 mtotal,  
		toes.mtotal/1.16 msubtotal, 
		tos.mtotal/1.16 mfactura, 
		0 knegociacion, 
		' ' snegociacion, 
		' ' snemexamen, 
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' || tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    0 kpagofundacion,
    cer.sestadoregistro sestado
from t_orden_sucursal tos inner join t_paciente tp on tos.kpaciente= tp.kpaciente
inner join t_orden_examen_sucursal toes on tos.kordensucursal=toes.kordensucursal
inner join c_examen ce on toes.cexamen=ce.cexamen
inner join c_estado_registro cer on tos.cestadoregistro=cer.cestadoregistro
--inner join ccomunidad cc on bpf.ccomunidad = cc.ccomunidad
inner join turbine_user tu on tu.user_id= tos.user_id
--where tos.cestadoregistro= 14 --and bof.cestado = 2 
where (tos.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tos.csucursal=$P{csucursal}
order by knegociacion,korden,kpagofundacion]]></queryString>
