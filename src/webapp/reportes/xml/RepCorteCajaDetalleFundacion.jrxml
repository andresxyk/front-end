<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="RepCorteCajaDetalleFundacion"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="554"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="28"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="objfechaini" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechafin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="csucursal" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select   distinct tos.kordensucursal  indexkadmision,
        tos.kordensucursal kadmision, 
		    tos.dregistro dcaptura, 
        tos.ssucursal snemunidad, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		tos.csucursal cunidad,    
                tos.mtotal totalorden,
		'' stituloimpresion, 
		---tpp.msaldo mtotal,  
		get_saldo(tos.kordensucursal) mtotal,
		get_devolucion(tos.kordensucursal) devolucion,
		toes.smotivocancelacion motivo,
		'0' msubtotal, 
		tpp.mpagopacienteparcial mfactura, 
		ctp.stipopago tipopago,
		1 knegociacion, 
		' ' snegociacion, 
		tu.login_name snemexamen, 
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' || tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    0 kpagofundacion
from t_orden_sucursal tos inner join t_paciente tp on tos.kpaciente= tp.kpaciente
inner join t_orden_examen_sucursal toes on tos.kordensucursal=toes.kordensucursal
inner join t_pago_paciente tpp on tos.kordensucursal= tpp.kordensucursal
inner join turbine_user tu on tu.user_id= tpp.user_id
inner join c_tipo_pago ctp on tpp.ctipopago=ctp.ctipopago
where tpp.kcortecaja =$P{kcortecaja} and tos.csucursal = $P{csucursal}
union all
select  0  indexkadmision,
	tos.kordensucursal kadmision, 
		    tos.dregistro dcaptura, 
        tos.ssucursal snemunidad, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		tos.csucursal cunidad,    
                tos.mtotal totalorden,
		'' stituloimpresion, 
		---tpp.msaldo mtotal,
                get_saldo(tos.kordensucursal) mtotal,
		get_devolucion(tos.kordensucursal) devolucion,  
		toes.smotivocancelacion motivo,
		tpp.mpagopacienteparcial msubtotal, 
		tpp.mpagopacientetotal mfactura, 
		ctp.stipopago tipopago,
		2 knegociacion, 
		'' snegociacion, 
		tu.login_name snemexamen, 
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' ||tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    tpp.kpagopaciente
from t_orden_sucursal tos inner join t_paciente tp on tos.kordensucursal= tp.kpaciente
inner join t_orden_examen_sucursal toes on tos.kordensucursal=toes.kordensucursal
inner join t_pago_paciente tpp on tos.kordensucursal= tpp.kordensucursal
inner join turbine_user tu on tu.user_id= tpp.user_id
inner join c_tipo_pago ctp on tpp.ctipopago=ctp.ctipopago
where tpp.kcortecaja =$P{kcortecaja} and tos.csucursal = $P{csucursal}
order by knegociacion,korden,kpagofundacion]]></queryString>
