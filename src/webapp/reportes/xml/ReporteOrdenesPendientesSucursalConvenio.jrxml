<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ReporteOrdenesPendientesSucursalConvenio"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="792"
		 pageHeight="612"
		 columnWidth="732"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="imagen" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String"/>
	<parameter name="cconvenio" isForPrompting="false" class="java.lang.Integer"/>
	<queryString><![CDATA[select  (nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) orden, 	
 to_char(tos.dregistro,'dd-mm-yyyy') fecha_captura,					
 to_char(tos.dresultadoentrega,'dd-mm-yyyy') promesa,				
 nvl(tp.sapellidopaterno,' ') || ' ' || nvl(tp.sapellidomaterno,' ') || ' ' || nvl(tp.snombre,' ') paciente,
 0 burgente,													
 tos.mfacturaempresa total,
 cs.csucursal,										
 cs.snombresucursal  ssucursal,
 cc.cconvenio idconvenio,											
 cc.cconvenio||' '||cc.sconvenio||' '||cc.ctipoconvenio sconvenio,						
 tu.first_name||' '||tu.last_name usuario_captura,
 cer.sestadoregistro estado,									
 0 kviajefac													
 from  t_orden_sucursal tos 											
 LEFT JOIN  t_orden_sucursal_fac tpp ON tos.kordensucursal = tpp.kordensucursal					
 INNER JOIN t_paciente tp       ON tp.kpaciente       = tos.kpaciente						
 INNER JOIN c_sucursal cs       ON tos.csucursal      = cs.csucursal						
 INNER JOIN c_convenio cc       ON tos.cconvenio      = cc.cconvenio and cc.ctipoconvenio = 22			
 INNER JOIN turbine_user tu     ON tos.user_id        = tu.user_id
 INNER JOIN c_estado_registro cer ON cer.cestadoregistro = tos.cestadoregistro						
 where (tos.dregistro between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 				
 and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 			
 and tos.cestadoregistro<>17 											
 and tpp.kordensucursal is null											
 and tos.mpagopaciente = 0 											
 and tos.csucursal <>100 
 and tos.cconvenio=$P{cconvenio}
 order by 7,9 desc]]></queryString>
	<field name="orden" class="java.lang.String"/>
	<field name="paciente" class="java.lang.String"/>
	<field name="sconvenio" class="java.lang.String"/>
	<field name="total" class="java.lang.Double"/>
	<field name="estado" class="java.lang.String"/>
	<field name="fecha_captura" class="java.lang.String"/>
	<field name="ssucursal" class="java.lang.String"/>
	<field name="usuario_captura" class="java.lang.String"/>
	<field name="idconvenio" class="java.lang.Integer"/>
	<variable name="empresa_MTOTAL" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
