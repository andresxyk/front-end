	<queryString><![CDATA[select  0 indexkadmision,
        cm.czona kadmision, 
	sysdate dcaptura, 
	cm.srfc korden, 
	0 comision,
	0 cexamen,   
	(nvl(trim(cm.scurp),'-')) stituloimpresion,
	tcm.msubtotal msubtotal, 
	tcm.mretencion mfactura, 
	0 idpaciente,
	cm.sapellidopaterno || ' ' || cm.sapellidomaterno || ' ' || cm.snombre spaciente,
	0 kordenfundacion,    
	0 clave,
	0 zona,
	'' direccionmedico,
	'' tel,
	cm.sapellidopaterno || ' ' || cm.sapellidomaterno || ' ' || cm.snombre nombre_medico,
	'' especialidad,
	sysdate promesa,
	'' sucursal,
	'' convenio,
	0 cheque,
	0 sumcomision	
from c_medico cm inner join t_comision_medico tcm on cm.cmedico=tcm.cmedico AND tcm.UCORTEMEDICO = (SELECT max(UCORTEMEDICO) FROM T_COMISION_MEDICO) AND tcm.CFORMAPAGOMEDICO IN (0)
order by cm.cclave]]></queryString>
