<!-- Created with iReport - A designer for JasperReports -->
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="ReporteFacturacion"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="792"
		 pageHeight="612"
		 columnWidth="732"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="imagen" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String"/>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String"/>
	<parameter name="cconvenio" isForPrompting="false" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT TF.kfactura,cc.ccliente cliente, srazonsocial AS razon_social, srfc rfc,cc.cconvenio convenio, cc.sconvenio AS nombre_convenio, 
sserie serie,ufoliofactura AS folio,
tf.msubtotal subtotal,	tf.miva iva,	tf.mtotal total,	 
decode (tf.cestadoregistro, 33, 'EMITIDA',51, 'PAGADA', 34,'CANCELADA', tf.CESTADOREGISTRO) AS estado,	
decode (tf.cestadoregistro, 33, to_char(tf.dregistro,'dd-mm-yyyy'),51, to_char(tf.dregistro,'dd-mm-yyyy'), 34, to_char(tf.dregistro,'dd-mm-yyyy'), 'no tiene') AS fecha_factura,
decode (tf.cestadoregistro, 34, to_char(tf.dcancelacionfactura, 'dd-mm-yyyy'), 33, ' ',51, ' ', 'no tiene') AS fecha_cancelacion
FROM T_FACTURA TF, T_DATO_FISCAL TDF, C_CONVENIO CC
WHERE TF.KDATOFISCAL= TDf.KDATOFISCAL
AND TF.CCONVENIO=CC.CCONVENIO
AND TF.DREGISTRO 	
BETWEEN TO_DATE($P{fechaini}, 'DD-MM-YYYY HH24:MI:SS')	
AND TO_DATE($P{fechafin}, 'DD-MM-YYYY HH24:MI:SS') 
AND tf.csucursal = 1003
AND tf.cconvenio=$P{cconvenio}
UNION ALL
SELECT TPF.kfactura,cc.ccliente cliente, srazonsocial AS razon_social, srfc rfc,cc.cconvenio convenio, cc.sconvenio AS nombre_convenio, 
sserie serie,ufoliofactura AS folio,
tf.msubtotal*-1 subtotal,tf.miva *-1 iva,tf.mtotal *-1 total,	 
decode (tf.cestadoregistro, 33, 'EMITIDA',51, 'PAGADA', 34,'CANCELADA', tf.CESTADOREGISTRO) AS estado,	
decode (tf.cestadoregistro, 33, to_char(tf.dregistro,'dd-mm-yyyy'),51, to_char(tf.dregistro,'dd-mm-yyyy'), 34, to_char(tf.dregistro,'dd-mm-yyyy'), 'no tiene') AS fecha_factura,
decode (tf.cestadoregistro, 34, to_char(tf.dcancelacionfactura, 'dd-mm-yyyy'), 33, ' ',51, ' ', 'no tiene') AS fecha_cancelacion
FROM T_NOTA_CREDITO TF, T_DATO_FISCAL TDF, C_CONVENIO CC,T_PAGO_FACTURA TPF
WHERE TF.KDATOFISCAL= TDf.KDATOFISCAL
AND TF.CCONVENIO=CC.CCONVENIO
AND TPF.KNOTACREDITO=TF.KNOTACREDITO	
AND TF.DREGISTRO 
BETWEEN TO_DATE($P{fechaini}, 'DD-MM-YYYY HH24:MI:SS')	
AND TO_DATE($P{fechafin}, 'DD-MM-YYYY HH24:MI:SS') 
--AND tf.csucursal = 1003
AND tf.cconvenio=$P{cconvenio}
order by 1,8 desc]]></queryString>
	<field name="cliente" class="java.lang.Integer"/>
	<field name="razon_social" class="java.lang.String"/>
	<field name="rfc" class="java.lang.String"/>
	<field name="convenio" class="java.lang.Integer"/>
	<field name="nombre_convenio" class="java.lang.String"/>
	<field name="serie" class="java.lang.String"/>
	<field name="folio" class="java.lang.Integer"/>
	<field name="subtotal" class="java.lang.Double"/>
	<field name="iva" class="java.lang.Double"/>
	<field name="total" class="java.lang.Double"/>
	<field name="estado" class="java.lang.String"/>
	<field name="fecha_factura" class="java.lang.String"/>
	<field name="fecha_cancelacion" class="java.lang.String"/>
	<variable name="empresa_MPAGO" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="empresa_MTOTAL" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{total}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
