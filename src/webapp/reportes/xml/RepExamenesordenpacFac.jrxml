<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="RepExamenesordenpacFac"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Landscape"
		 pageWidth="432"
		 pageHeight="104"
		 columnWidth="431"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="kadmision" isForPrompting="true" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="piva" isForPrompting="true" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="tipo" isForPrompting="true" class="java.lang.String">
		<defaultValueExpression ><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select 0,
	toesf.cexamen cexamen, 
	nvl(toesf.sexamen,' ') sexamen, 
	nvl(0,0) msubtotale,
	nvl(toesf.mpagopaciente,0) mfactura 
from t_orden_sucursal tos inner join t_orden_sucursal_fac tosf on tosf.kordensucursal=tos.kordensucursal 
		and tosf.kordensucursalfac in (select max(kordensucursalfac) from t_orden_sucursal_fac where kordensucursal in ($P{kadmision}))
		and tos.kordensucursal = $P{kadmision}
	inner join t_orden_examen_sucursal_fac toesf on tosf.kordensucursalfac = toesf.kordensucursalfac 
		and toesf.cperfil<0 
		and toesf.cexamen>0 
		and toesf.cestadoregistro not in (43)
union all 
select distinct  (cp.cperfil),
	cp.cperfil cexamen, 
	nvl(toesf.sperfil,' ') sexamen, 
	nvl(sum(0),0) msubtotale,
	nvl(sum(toesf.mpagopaciente),0) mfactura 
from t_orden_sucursal tos inner join t_orden_sucursal_fac tosf on tosf.kordensucursal=tos.kordensucursal 
		and tosf.kordensucursalfac in (select max(kordensucursalfac) from t_orden_sucursal_fac where kordensucursal in ($P{kadmision}))
		and tos.kordensucursal = $P{kadmision}
	inner join t_orden_examen_sucursal_fac toesf on tosf.kordensucursalfac = toesf.kordensucursalfac 	
		and toesf.cestadoregistro not in (43)
	inner join c_perfil cp on toesf.cperfil=cp.cperfil
		and cp.cperfil > 0 
group by cp.cperfil,toesf.sperfil]]></queryString>
	<field name="CEXAMEN" class="java.lang.Double"/>
	<field name="SEXAMEN" class="java.lang.String"/>
	<field name="MSUBTOTALE" class="java.lang.Double"/>
	<field name="MFACTURA" class="java.lang.Double"/>
