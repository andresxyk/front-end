<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN" "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport
		 name="RepEntregaResultados"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="554"
		 columnSpacing="0"
		 leftMargin="29"
		 rightMargin="29"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="AllSectionsNoDetail"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="unidad" isForPrompting="false" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="objDateFechaIni" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objDateFechaFin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="SUNIDAD" isForPrompting="false" class="java.lang.String"/>
	<parameter name="csucursal" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select  (nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
                      to_char(tos.dresultadoentrega,'mm-dd-yyyy') dpromesa,
                      nvl(tp.sapellidopaterno,' ') || ' ' || nvl(tp.sapellidomaterno,' ') || ' ' || nvl(tp.snombre,' ') spaciente,tp.scorreoelectronico,
                     --(select sum(boex.burgente) from bordenexamen boex where boex.kadmision = bo.kadmision) burgente, 
                     0 burgente,
                    get_saldo(tos.kordensucursal) adeudo, 
                      toes.sexamen titulo,-- de.snemonico, 
                      cs.snombresucursal  sunidad,
		      tos.kordensucursal admision,
		      cc.cconvenio||' '||cc.sconvenio convenio
from  t_orden_sucursal tos,  t_paciente tp, c_sucursal cs ,t_orden_examen_sucursal toes,c_convenio cc
where toes.kordensucursal=tos.kordensucursal AND 
tp.kpaciente= tos.kpaciente AND 
tos.csucursal= cs.csucursal AND
tos.cconvenio=cc.cconvenio
and (tos.dresultadoentrega 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tos.cestadoregistro<>17 and 
--tos.cestadoregistro <>13
tos.csucursal =$P{csucursal} and toes.cperfil<0
union
select  DISTINCT (nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
                      to_char(tos.dresultadoentrega,'mm-dd-yyyy') dpromesa,
                      nvl(tp.sapellidopaterno,' ') || ' ' || nvl(tp.sapellidomaterno,' ') || ' ' || nvl(tp.snombre,' ') spaciente,tp.scorreoelectronico,
                     --(select sum(boex.burgente) from bordenexamen boex where boex.kadmision = bo.kadmision) burgente, 
                     0 burgente,
                    get_saldo(tos.kordensucursal) adeudo, 
                      cp.sperfil titulo,-- de.snemonico, 
                      cs.snombresucursal  sunidad,
                      tos.kordensucursal admision,
                      cc.cconvenio||' '||cc.sconvenio convenio
from  t_orden_sucursal tos,  t_paciente tp, c_sucursal cs ,t_orden_examen_sucursal toes,c_convenio cc,c_perfil cp
where toes.kordensucursal=tos.kordensucursal AND 
tp.kpaciente= tos.kpaciente AND 
tos.csucursal= cs.csucursal AND
tos.cconvenio=cc.cconvenio AND
toes.cperfil=cp.cperfil
and (tos.dresultadoentrega 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tos.cestadoregistro<>17 and 
--tos.cestadoregistro <>13
tos.csucursal =$P{csucursal}
]]></queryString>
