<jasperReport
		 name="RepOrdenEstadoCuentaPuntos"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="552"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechaini" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechafin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="sunidad" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cunidad" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA["0"]]></defaultValueExpression>
	</parameter>
	<parameter name="filtro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nombrefiltro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="cmarca" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="cusuario" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0) ]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String"/>
	<parameter name="cmedico" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select   distinct tos.kordensucursal  indexkadmision,
        tos.kordensucursal kadmision, 
		    tos.dregistro dcaptura, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		toes.upuntosmedico comision,
		toes.cexamen cexamen,   
		toes.sexamen stituloimpresion,  
		toes.mpagopaciente msubtotal, 
		tos.mpagopaciente mfactura, 
		tp.kpaciente idpaciente,
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' || tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    cm.cclave clave,
    cm.czona zona,
    cdm.sdireccion ||' '||ccp.scolonia||' '||ccp.sdelegacionmunicipio||' CP.'||ccp.cpostal direccionmedico,
    cdm.stelefono tel,
    CASE
     WHEN cm.cmedico=5228 THEN cm.cclave ||' '||cm.sapellidopaterno
     ELSE cm.cclave || ' '||cm.snombre||' '||cm.sapellidopaterno||' '||cm.sapellidomaterno 
    END nombre_medico,
    ces.sespecialidad especialidad,
    tos.dresultadoentrega promesa,
    cs.snombresucursal sucursal,
    cc.cconvenio||' '|| cc.sconvenio convenio,
    0 cheque,
    0 sumcomision	
from t_orden_sucursal tos inner join t_paciente tp on tos.kpaciente= tp.kpaciente
inner join t_orden_examen_sucursal toes on tos.kordensucursal=toes.kordensucursal
inner join c_sucursal cs on tos.csucursal=cs.csucursal
inner join c_medico cm on tos.cmedico=cm.cmedico
inner join c_direccion_medico cdm on cm.cmedico=cdm.cmedico
inner join c_codigo_postal ccp on cdm.ccodigopostal=ccp.ccodigopostal
inner join c_convenio cc on toes.cconvenio=cc.cconvenio
inner join c_especialidad ces on cm.cespecialidad=ces.cespecialidad
inner join turbine_user tu on tu.user_id= tos.user_id
where tos.cestadoregistro <> 17 
and tos.bpuntomedicopagado = false
and (tos.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and cm.cclave=$P{cmedico}
and toes.cperfil<0
and tos.csucursal not in (13,14,100)
union all
select   distinct tos.kordensucursal  indexkadmision,
        tos.kordensucursal kadmision, 
		    tos.dregistro dcaptura, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		(SUM(toes.upuntosmedico)) comision,
		cper.cperfil cexamen,   
		cper.sperfil stituloimpresion,  
		(SUM(toes.upuntosmedico)) comision,
		tos.mpagopaciente mfactura, 
		tp.kpaciente idpaciente,
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' || tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    cm.cclave clave,
    cm.czona zona,
    cdm.sdireccion ||' '||ccp.scolonia||' '||ccp.sdelegacionmunicipio||' CP.'||ccp.cpostal direccionmedico,
    cdm.stelefono tel,
    CASE
     WHEN cm.cmedico=5228 THEN cm.cclave ||' '||cm.sapellidopaterno
     ELSE cm.cclave || ' '||cm.snombre||' '||cm.sapellidopaterno||' '||cm.sapellidomaterno 
    END nombre_medico,
    ces.sespecialidad especialidad,
    tos.dresultadoentrega promesa,
    cs.snombresucursal sucursal,
    cc.cconvenio||' '|| cc.sconvenio convenio,
    0 cheque,
    0 sumcomision	
from t_orden_sucursal tos inner join t_paciente tp on tos.kpaciente= tp.kpaciente
inner join t_orden_examen_sucursal toes on tos.kordensucursal=toes.kordensucursal
inner join c_perfil cper on toes.cperfil=cper.cperfil
inner join c_sucursal cs on tos.csucursal=cs.csucursal
inner join c_medico cm on tos.cmedico=cm.cmedico
inner join c_direccion_medico cdm on cm.cmedico=cdm.cmedico
inner join c_codigo_postal ccp on cdm.ccodigopostal=ccp.ccodigopostal
inner join c_convenio cc on toes.cconvenio=cc.cconvenio
inner join c_especialidad ces on cm.cespecialidad=ces.cespecialidad
inner join turbine_user tu on tu.user_id= tos.user_id
where tos.cestadoregistro <> 17 --and bof.cestado = 2 
and tos.bpuntomedicopagado = false
and cm.cclave=$P{cmedico}
and (tos.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
and tos.csucursal not in (13,14,100)
GROUP BY tos.kordensucursal,tos.dregistro,tos.ssucursal,tos.uorden,cper.cperfil,cper.sperfil,tos.mpagopaciente,tp.kpaciente,tp.sapellidopaterno,
tp.sapellidomaterno,tp.snombre,
    tos.kordensucursal,    
    cm.cclave,
    cm.czona,cdm.sdireccion,ccp.scolonia,ccp.sdelegacionmunicipio,ccp.cpostal,
    cdm.stelefono,cm.cmedico,cm.sapellidopaterno,cm.sapellidomaterno,ces.sespecialidad,cm.snombre,
    tos.dresultadoentrega,
    cs.snombresucursal,
    cc.cconvenio,cc.sconvenio]]></queryString>
