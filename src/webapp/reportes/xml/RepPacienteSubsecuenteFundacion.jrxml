	</parameter>
	<parameter name="filtro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nombrefiltro" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="nexamen" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="cusuario" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0) ]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select  distinct(bpf.kpacientefundacion) indexkadmision,
        bpf.kpacientefundacion kadmision, 
        bpf.dregistro dcaptura, 
        '' snemunidad, 
        bpf.kpacientefundacion || '' korden,
        '' cunidad,    
        '' stituloimpresion, 
        0 mtotal,  
        0 msubtotal, 
        0 mfactura, 
        cc.ccomunidad knegociacion, 
        cc.scomunidad snegociacion, 
        '' snemexamen, 
        nvl((bpf.sappaterno || ' ' || bpf.sapmaterno || ' ' || bpf.snombre),0) spaciente,
        bpf.kpacientefundacion kordenfundacion,    
        0 kpagofundacion
from bpacientefundacion bpf inner join ccomunidad cc on bpf.ccomunidad = cc.ccomunidad 
where kpacientefundacion in
(select bpf.kpacientefundacion
from bordenfundacion bof inner join bpacientefundacion bpf on bof.kpacientefundacion= bpf.kpacientefundacion
inner join turbine_user tu on tu.user_id= bof.cusuario
where bof.kpacientefundacion in (SELECT kpacientefundacion FROM bordenfundacion having count(kpacientefundacion) > 1 GROUP BY kpacientefundacion) 
and  bof.cestado<> 2 and (bof.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')))
order by knegociacion,korden,kpagofundacion]]></queryString>
