	<queryString><![CDATA[select   distinct tos.kordensucursal  indexkadmision,
        tos.kordensucursal kadmision, cs.snombresucursal sucursal,
		    tos.dregistro dcaptura, 
        '' snemunidad, 
		(nvl(trim(tos.ssucursal),'') || trim(to_char(nvl(tos.uorden,0),'00000000'))) korden, 
		'' cunidad,    
		toes.sexamen stituloimpresion, 
		0 mtotal,  
		toes.mpagopaciente msubtotal, 
		tos.mpagopaciente mfactura, 
		0 knegociacion, 
		' ' snegociacion, 
		' ' snemexamen, 
		tp.sapellidopaterno || ' ' || tp.sapellidomaterno || ' ' || tp.snombre spaciente,
    tos.kordensucursal kordenfundacion,    
    0 kpagofundacion,
    CASE
	WHEN cm.cmedico=5228 THEN cm.cclave ||' '||cm.sapellidopaterno
	WHEN cm.cmedico=5479 THEN cm.cclave ||' '||cm.sapellidopaterno
