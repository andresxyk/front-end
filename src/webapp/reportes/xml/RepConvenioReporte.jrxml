	<queryString><![CDATA[select 
  trec.cexamen cexamen,
  trec.sexamen sexamen,
  trec.cperfil cperfil,
    CASE
	WHEN trec.cperfil=-1 THEN 'EXAMENES '
     ELSE trec.sperfil 
    END sperfil,
  trec.msubtotal msubtotal,
  trec.mdescuentoempresa mdescuento,
  trec.pdescuentoempresa pdescuento,
  trec.mfacturaempresa mfactura,
  trec.mpagopaciente mpagopaciente,
  CAST((trec.mtotal/1.16) as decimal(16,2)) as mtotal,
  trec.cclasificacioncomercial cclasificacion,
  trec.sclasificacioncomercial sclasificacion,
  trec.cconvenio cconvenio,
  cc.sconvenio sconvenio,
  trec.cperfil korden,
  trec.cperfil knegociacion 
from t_reporte_examen_convenio trec inner join c_convenio cc on trec.cconvenio= cc.cconvenio
order by trec.cperfil]]></queryString>
