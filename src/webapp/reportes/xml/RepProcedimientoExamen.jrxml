<jasperReport
		 name="RepProcedimientoExamen"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="549"
		 pageHeight="791"
		 columnWidth="549"
		 columnSpacing="0"
		 leftMargin="0"
		 rightMargin="0"
		 topMargin="0"
		 bottomMargin="0"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="kordensucursalcotizacion" isForPrompting="true" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[SELECT distinct eec.cindicacionpaciente uorden,
       eec.sindicacionpaciente sprocedimientopaciente
FROM E_EXAMEN_CONFIGURACION eec 	
	INNER JOIN C_EXAMEN ce 			
	ON eec.cexamen=ce.cexamen 		
WHERE ce.cexamen IN (SELECT toesc.cexamen cexamen
		     FROM T_ORDEN_SUCURSAL_COTIZACION TOSC INNER JOIN T_ORDEN_EXAMEN_SUCURSAL_COTIZACION TOESC ON 
						 TOSC.KORDENSUCURSALCOTIZACION= TOESC.KORDENSUCURSALCOTIZACION
		     WHERE TOSC.KORDENSUCURSALCOTIZACION IN ($P{kordensucursalcotizacion})) and eec.cindicacionpaciente = -1


]]></queryString>
	<field name="UORDEN" class="java.lang.Double"/>
	<field name="SPROCEDIMIENTOPACIENTE" class="java.lang.String"/>
