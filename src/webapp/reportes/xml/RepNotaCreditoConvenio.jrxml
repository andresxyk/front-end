	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechaini" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechafin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="convenio" isForPrompting="false" class="java.lang.Integer"/>
	<queryString><![CDATA[select (nvl(trim(tnc.sserie),'') || trim(to_char(nvl(tnc.ufoliofactura,0),'00000000'))) notacredito,tnc.dregistro fechanota,tnc.msubtotal msubtotalnota,tnc.mtotal mtotalnota,
(nvl(trim(tf.sserie),'') || trim(to_char(nvl(tf.ufoliofactura,0),'00000000'))) factura,tf.dregistro fechafactura,tpf.mpago mtotalpagonota,tf.mtotal mtotalfactura, tf.mtotal-tpf.mpago msaldofactura,
cc.cconvenio idconvenio,cc.sconvenio
from t_nota_credito tnc, t_pago_factura tpf,t_factura tf,c_convenio cc
where tnc.knotacredito=tpf.knotacredito 
and tf.cconvenio=cc.cconvenio 
and tf.kfactura=tpf.kfactura
and (tnc.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss'))
and tnc.cconvenio=$P{convenio}]]></queryString>
	<field name="notacredito" class="java.lang.String"/>
	<field name="fechanota" class="java.sql.Timestamp"/>
	<field name="msubtotalnota" class="java.lang.Double"/>
	<field name="mtotalnota" class="java.lang.Double"/>
	<field name="factura" class="java.lang.String"/>
	<field name="fechafactura" class="java.sql.Timestamp"/>
	<field name="mtotalpagonota" class="java.lang.Double"/>
	<field name="mtotalfactura" class="java.lang.Double"/>
	<field name="msaldofactura" class="java.lang.Double"/>
	<field name="idconvenio" class="java.lang.Double"/>
	<field name="sconvenio" class="java.lang.String"/>
	<variable name="GRAN_TOTAL" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{mtotalpagonota}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="montototalfactura" class="java.lang.Double" resetType="Group" resetGroup="notacredito" calculation="Sum">
