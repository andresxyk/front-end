<jasperReport
		 name="RepIndicaciones"
		 columnCount="1"
		 printOrder="Vertical"
		 orientation="Portrait"
		 pageWidth="612"
		 pageHeight="792"
		 columnWidth="535"
		 columnSpacing="0"
		 leftMargin="30"
		 rightMargin="30"
		 topMargin="20"
		 bottomMargin="20"
		 whenNoDataType="NoPages"
		 isTitleNewPage="false"
		 isSummaryNewPage="false">
	<property name="ireport.scriptlethandling" value="0" />
	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="repprocedimientoexamen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="repindicacionpaciente" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="kordensucursalcotizacion" isForPrompting="true" class="java.lang.Double">
		<defaultValueExpression ><![CDATA[new Double(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select     0 cperfil,
	   '' sperfil,
	   toesc.cexamen cexamen, 
	   0 claboratorioexamen, 
	   toesc.sexamen stituloimpresion, 
	   cs.snombresucursal sunidad,cs.sdireccion scalle, 
	   nvl('Tel: ' || cs.stelefono, ' Sin Tel') stelefono,   
	   (ccp.scolonia || ' C.P.' || ccp.cpostal || ' ' || ccp.sciudad) cp,
	   (nvl(trim(tp.sapellidopaterno), '') || ' ' || nvl(trim(tp.sapellidomaterno),'') || ' ' || nvl(trim(tp.snombre),'')) spaciente,
	   toesc.mpagopaciente precio,
	   toesc.uvolumenexamen volumenexamen,	
	   (TU.FIRST_NAME || ' ' || TU.LAST_NAME) susuario,
	   (to_char(cc.cconvenio) || ' ' || cc.sconvenio) sconvenio,
           tosc.mpagopaciente precioorden
FROM T_ORDEN_SUCURSAL_COTIZACION TOSC INNER JOIN T_ORDEN_EXAMEN_SUCURSAL_COTIZACION TOESC ON TOSC.KORDENSUCURSALCOTIZACION= TOESC.KORDENSUCURSALCOTIZACION
				      INNER JOIN C_SUCURSAL CS ON CS.CSUCURSAL = TOSC.CSUCURSAL   	
				      INNER JOIN C_CODIGO_POSTAL CCP ON CCP.CCODIGOPOSTAL=CS.CCODIGOPOSTAL
				      INNER JOIN T_PACIENTE TP ON TOSC.KPACIENTE=TP.KPACIENTE
				      INNER JOIN TURBINE_USER TU ON TU.USER_ID=TOSC.USER_ID	
				      INNER JOIN C_CONVENIO CC ON TOSC.CCONVENIO=CC.CCONVENIO
WHERE TOSC.KORDENSUCURSALCOTIZACION IN ($P{kordensucursalcotizacion}) AND TOESC.CPERFIL IN (-1)
UNION ALL
select     0 cperfil,
	   '' sperfil,
	   toesc.cperfil cexamen, 
	   0 claboratorioexamen, 
	   cp.sperfil stituloimpresion, 
	   cs.snombresucursal sunidad,cs.sdireccion scalle, 
	   nvl('Tel: ' || cs.stelefono, ' Sin Tel') stelefono,   
	   (ccp.scolonia || ' C.P.' || ccp.cpostal || ' ' || ccp.sciudad) cp, 
	   (nvl(trim(tp.sapellidopaterno), '') || ' ' || nvl(trim(tp.sapellidomaterno),'') || ' ' || nvl(trim(tp.snombre),'')) spaciente,
	   SUM(toesc.mpagopaciente) precio,
	   1 volumenexamen,	
	   (TU.FIRST_NAME || ' ' || TU.LAST_NAME) susuario,
	   (to_char(cc.cconvenio) || ' ' || cc.sconvenio) sconvenio,
           tosc.mpagopaciente precioorden
FROM T_ORDEN_SUCURSAL_COTIZACION TOSC INNER JOIN T_ORDEN_EXAMEN_SUCURSAL_COTIZACION TOESC ON TOSC.KORDENSUCURSALCOTIZACION= TOESC.KORDENSUCURSALCOTIZACION
				      INNER JOIN C_SUCURSAL CS ON CS.CSUCURSAL = TOSC.CSUCURSAL   	
				      INNER JOIN C_CODIGO_POSTAL CCP ON CCP.CCODIGOPOSTAL=CS.CCODIGOPOSTAL
				      INNER JOIN C_PERFIL CP ON CP.CPERFIL=TOESC.CPERFIL
				      INNER JOIN T_PACIENTE TP ON TOSC.KPACIENTE=TP.KPACIENTE
				      INNER JOIN TURBINE_USER TU ON TU.USER_ID=TOSC.USER_ID	
				      INNER JOIN C_CONVENIO CC ON TOSC.CCONVENIO=CC.CCONVENIO
WHERE TOSC.KORDENSUCURSALCOTIZACION IN ($P{kordensucursalcotizacion}) AND TOESC.CPERFIL NOT IN (-1)
GROUP BY toesc.cperfil,cp.sperfil,cs.snombresucursal,cs.sdireccion,cs.stelefono,ccp.scolonia,ccp.cpostal,ccp.sciudad,tp.sapellidopaterno,tp.sapellidomaterno,tp.snombre,TU.FIRST_NAME,TU.LAST_NAME,cc.cconvenio,cc.sconvenio,tosc.mpagopaciente
order by 3,5]]></queryString>
