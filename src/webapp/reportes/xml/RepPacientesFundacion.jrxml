	<import value="java.util.*" />
	<import value="net.sf.jasperreports.engine.*" />
	<import value="net.sf.jasperreports.engine.data.*" />
	<parameter name="fechaini" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="fechafin" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="imagen" isForPrompting="false" class="java.lang.String">
		<defaultValueExpression ><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechaini" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<parameter name="objfechafin" isForPrompting="false" class="java.util.Date">
		<defaultValueExpression ><![CDATA[new Date()]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select tp.kpaciente kadmision,
trim(nvl(upper(to_char(tp.dregistro,'dd-mon-yyyy')),' ')) dcaptura, 
'' snombre, 
tp.kpaciente || '' korden,
trim(nvl(trim(tp.snombre),' ') || ' ' || nvl(trim(tp.sapellidopaterno),' ') || ' ' || nvl(trim(tp.sapellidomaterno),' ')) snombrepac,
initcap ( 
		nvl(tp.sdireccion, 'Sin Direcci&oacute;n ') || ' ' || 
		nvl(cc.sdelegacionmunicipio,' ') || ' ' || 
		nvl(cc.scolonia,' ') )  || 
		nvl(tp.ccodigopostal,0) 
		sdireccion,
nvl(tp.stelefono,' Tel ') stelefono,
0 mtotal,
0 descuento,  
0 pagos_contado,
0 saldo    
from t_paciente tp 
inner join c_codigo_postal cc on tp.ccodigopostal=cc.ccodigopostal
where (tp.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
order by tp.kpaciente]]></queryString>
