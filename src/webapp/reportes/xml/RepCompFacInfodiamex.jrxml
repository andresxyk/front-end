cm.cclave clvmedico,
tos.dregistro, to_char(tos.dregistro,'hh24:mi') dhoracaptura, 
tos.dresultadoentrega, to_char(tos.dresultadoentrega,'hh24:mi') dhorapromesa, 
sysdate dfecha, to_char(sysdate,'hh24:mi') dhorafecha, 
(nvl(tos.piva,0)/100) piva,
