		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="cusuario" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0) ]]></defaultValueExpression>
	</parameter>
	<parameter name="nombreusuario" isForPrompting="false" class="java.lang.String"/>
	<queryString><![CDATA[select   distinct bof.kordenfundacion  indexkadmision,
        bof.kordenfundacion kadmision, 
		    bof.dregistro dcaptura, 
        '' snemunidad, 
		(nvl(trim(bof.sordenfundacion),'') || trim(to_char(nvl(bof.cordenfundacion,0),'00000000'))) korden, 
		boef.umuestra cunidad,    
		cef.sexamenfundacion stituloimpresion, 
		0 mtotal,  
		bof.macuenta msubtotal, 
		boef.mtotal mfactura, 
		1 knegociacion, 
		'Tacubaya' snegociacion, 
		cef.sexamenfundacion snemexamen, 
		nvl((bpf.sappaterno || ' ' || bpf.sapmaterno || ' ' || bpf.snombre),0) spaciente,
    bof.kordenfundacion kordenfundacion,    
    0 kpagofundacion
from bordenfundacion bof inner join bpacientefundacion bpf on bof.kpacientefundacion= bpf.kpacientefundacion
inner join bordenexamenfundacion boef on bof.kordenfundacion=boef.kordenfundacion
inner join cexamenfundacion cef on boef.cexamenfundacion=cef.cexamenfundacion
inner join turbine_user tu on tu.user_id= bof.cusuario
where boef.cestado<> 2 and bof.cestado<> 2 and (bof.dregistro 
between to_date($P{fechaini}, 'dd-mm-yyyy hh24:mi:ss') 
and to_date($P{fechafin}, 'dd-mm-yyyy hh24:mi:ss')) 
order by knegociacion,korden,kpagofundacion]]></queryString>
