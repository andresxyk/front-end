	<parameter name="kcortecaja" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<parameter name="csucursal" isForPrompting="false" class="java.lang.Integer">
		<defaultValueExpression ><![CDATA[new Integer(0)]]></defaultValueExpression>
	</parameter>
	<queryString><![CDATA[select ctp.ctipopago, ctp.stipopago,
	nvl(sum(tpp.mpagopacienteparcial),0) mpago
from t_pago_paciente tpp
inner join t_corte_caja tcc on tpp.kcortecaja = tcc.kcortecaja 
inner join t_orden_sucursal tos on tpp.kordensucursal = tos.kordensucursal
right outer join c_tipo_pago ctp on tpp.ctipopago = ctp.ctipopago
and tcc.kcortecaja = $P{kcortecaja}
and tos.csucursal = $P{csucursal}
and tos.cestadoregistro<>17
group by ctp.ctipopago, ctp.stipopago
having sum(tpp.mpagopacienteparcial)>0
order by 1 asc]]></queryString>
	<field name="CTIPOPAGO" class="java.lang.Double"/>
	<field name="STIPOPAGO" class="java.lang.String"/>
	<field name="MPAGO" class="java.lang.Double"/>
	<variable name="TOTPAGOS" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{MPAGO}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
	<variable name="SUBTOT_BANCOS" class="java.lang.Double" resetType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{MPAGO}]]></variableExpression>
		<initialValueExpression><![CDATA[new Double(0)]]></initialValueExpression>
	</variable>
