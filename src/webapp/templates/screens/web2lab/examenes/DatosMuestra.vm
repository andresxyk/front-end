<script language="javascript">
	var objArreglo = new Array();
    var intIndiceA = 1;
	#if($muestrasBuscadas)
    	#foreach( $muestra in $muestrasBuscadas )
        	objArreglo[ intIndiceA ] = [ '$!muestra.getCmuestra()' ,'$!muestra.getSmuestra()', '$!muestra.getSinstruccion()' ];
        	intIndiceA = intIndiceA + 1;
    	#end	
	#else
    	#foreach($muestra in $objMuestras)
        	objArreglo[ intIndiceA ] = [ '$!muestra.getCmuestra()' ,'$!muestra.getSmuestra()', '$!muestra.getSinstruccion()' ];
        	intIndiceA = intIndiceA + 1;
    	#end
	#end
</script>

<form name="frmDatosMuestra" action="$strLigaActual" method="post" >	
	<table border="0" cellspacing="2" cellpadding="3" width="100%" class="tabla">
		<tr>
			<td colspan="3">		
				#if($aStrMsjError)							
					<img align="middle" src="$content.getURI('images/icon_error_sml.gif')"/>&nbsp;&nbsp;
					<b><font color="$ff0030" aling="center">$aStrMsjError</font></b>				
				#elseif($aStrMensaje)							
					<img align="middle" src="$content.getURI('images/icon_success_sml.gif')"/>&nbsp;&nbsp;
					<b><font color="$339933" aling="center">$aStrMensaje</font></b>				
				#end					
			</td>
		</tr>
		<tr>
			<td align="right">
				<input type="hidden" name="hdnCExamenMuestra">
				<input type="hidden" name="hdnSecuencia">
				<input type="hidden" name="hdnStrMuestra">
				<input type="hidden" name="hdnIntMuestra">
				<input type="hidden" name="hdnIndexMuestra">
				<input type="hidden" name="hdnStrInstruccion">
				<b>Buscar por nombre de muestra:</b> 
			</td>
			<td>
				<input type="text" name="txtNombreMuestra" size="30" value="$!aStrNombreMuestra" >
			</td>
			<td align="center">
				<input type="submit" value="Buscar muestras" name="eventSubmit_doBuscarmuestras" class="boton" onClick="return validaBuscarmuestra();">
			</td>			
		</tr>
		<tr><td>&nbsp;</td></tr>		
		<tr>
			<td colspan="2" align="center" >#comboMuestras()</td>												
			<td align="center" valign="top">
				<input type="submit" value="Asignar muestra" name="eventSubmit_doAgregarmuestra" class="boton" onClick="return validaConfigurarmuestra();">
			</td>
		</tr>
		<tr><td>&nbsp;</td></tr>		
		<tr><td>&nbsp;</td></tr>
	</table>	
	<table border="0" cellspacing="2" cellpadding="3" width="100%" class="tabla" id="muestras">
			<tr>
				<th width="55%" nowrap>Muestra</th>
				<th width="15%" nowrap>Primaria</th>
				<th width="15%" nowrap>Secuencia</th>
				<th width="15%" nowrap>&nbsp;</th>
			</tr>
		#set( $intCont = 0 )
		#muestras()
	</table>
	<table border="0" cellspacing="2" cellpadding="3" width="100%" class="tabla">		
		<tr><td>&nbsp;<input type="hidden" name="hdnNumMuestras" value="$intCont" ></td></tr>
		<tr><td>&nbsp;<input type="hidden" name="hdnPrimaria" value="" ></td></tr>
		<tr>
			<td align="center">
				<input type="submit" value="Guardar" name="eventSubmit_doAsignarmuestrasexamen" class="boton" onclick="return verificaPrimario();">
			</td>			
			<td align="center">
				<input type="submit" value="Regresar" name="eventSubmit_doRegresarexamen" class="boton">
			</td>			
		</tr>		
	</table>	
</form>
	