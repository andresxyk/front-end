#set($tool=$CCatalogosTool)

#macro(combotipos $indicador $default)
	<select name="cboTipoMuestra$!indicador" class="selector80">
		<option value="0_0">Seleccionar</option>
    	#foreach($tipo in $objTipoMuestras)
    		#set($selected="")
			#set($display="")
    		#if("$!default"=="$!tipo.getCtipomuestra()")#set($selected="selected")#end
			#if("$!tipo.getStipomuestra()"=="$!tool.getSTipoMuestraPrimaria()")
				#set($display = "Y")
			#elseif("$!tipo.getStipomuestra()"=="$!tool.getSTipoMuestraSecundaria()") 
				#set($display = "O")
			#else
				#set($display = "$!tipo.getCtipomuestra() - NA")
			#end
    		<option value="$!tipo.getCtipomuestra()" $!selected>$!display</option>
    	#end
	</select>
#end

#macro(comboMuestras)
	<select name="cboMuestras" size="10" width="100%" class="selector350" >
	#if($muestrasBuscadas)
		#foreach($muestra in $muestrasBuscadas)
			<option value="$velocityCount" >$muestra.getCmuestra() - $muestra.getSmuestra()</option>
		#end
	#end			
	</select>	
#end 

#macro(asignaVariables $bean)
	#set($cexamenmuestra = $!bean.getDexamenmuestra().getCexamenmuestra())
	#set($cmuestra = $!bean.getDexamenmuestra().getCmuestra().getCmuestra())
	#set($smuestra = $!bean.getDexamenmuestra().getCmuestra().getSmuestra())
	#set($usecuencia=$!bean.getDexamenmuestra().getUsecuencia())
	#set($ctipomuestra = $!bean.getDexamenmuestra().getStipomuestra().getCtipomuestra())
	#set($stipomuestra = $!bean.getDexamenmuestra().getStipomuestra().getStipomuestra())
#end

#macro(limpiaVariables)
	#set($cexamenmuestra = "")
	#set($cmuestra = "")
	#set($smuestra = "")
	#set($usecuencia = "")
	#set($ctipomuestra = "")
	#set($stipomuestra = "")
#end

#macro(muestras)
	#foreach($muestraBean in $muestrasBean)
		#set( $intCont =  $velocityCount)
		#limpiaVariables()
		#asignaVariables($!muestraBean)
		<tr>
			<td>
				<input type="hidden" name="hdnCExamenMuestra$velocityCount" value="$!cexamenmuestra">
				<input type="hidden" name="hdnCMuestra$velocityCount" value="$!cmuestra">
				<input type="hidden" name="hdnSMuestra$velocityCount" value="$!smuestra">	
				<b>$!cmuestra - $!smuestra</b>
			</td>
			<td>
			##	#combotipos($velocityCount "$!ctipomuestra")
				#if($!ctipomuestra == 1)
					<input type="radio" name="primario" value="$velocityCount" checked> 
				#else
					<input type="radio" name="primario" value="$velocityCount"> 
				#end

			</td>
			<td>
				#if("$!usecuencia" != '') #set($secmuestra=$!$usecuencia) #else #set($secmuestra= 0) #end
##				#if($!muestraBean.getIObjIntSecuencia()) #set($secmuestra=$!muestraBean.getIObjIntSecuencia()) #else #set($secmuestra= 0) #end
				<input type="text" name="txtSecuencia$velocityCount" value="$!secmuestra" size="10">
			</td>
			<td>
				<input type="submit" value="Configurar" name="eventSubmit_doIreditarmuestra" class="boton" onClick='return editarMuestra("$velocityCount");'>
			</td>			
		</tr>
		#limpiaVariables()
	#end
#end

