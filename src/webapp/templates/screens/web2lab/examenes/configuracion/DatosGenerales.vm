<style type="text/css">
.tableBorder {
 font-size: 11px;
 color: #000000;
 line-height: normal;
 font-family: Arial, Helvetica, sans-serif;
 background-color : #DFEAF7;
 border-color: darkblue;
 border-style: solid;
}    
.selector { width: 150px; }
.selector350 { width: 350px; }
