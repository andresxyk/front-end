$data.setLayoutTemplate("web2lab/SoloPleca.vm")
#set ( $titlePage = "Examenes de un Perfil" )
#set ( $cperfil = $data.getParameters().getString("cperfil",""))
#set ( $sperfil = $data.getParameters().getString("sperfil",""))
#if($cperfil && $cperfil!="")
	#set ( $examenes = $BCotizadorCarperTool.getExamenesDelPerfil())
#end
<form name="frmConsExamen" method="post">
	<table class="tabla" width="100%" border="0">
		<tr><th colspan="3">Perfil</th></tr>
		<tr>
			<th>C&oacute;digo</th>
			<th>Perfil/Paquete</th>
		</tr>	
		<tr>
			<td>$!cperfil</td>
			<td>$!sperfil</td>
		</tr>	
		<!-- seccion de examenes -->
		<tr><th colspan="2">Examenes</th></tr>
		<tr>
			<th>C&oacute;digo</th>
			<th>Examen</th>
		</tr>	
		#foreach($examen in $examenes)
			#set ( $cexamen = $examen.getcExamen())
			#set ( $sexamen = $examen.getsExamen())
			#if ( $t == "azul2") #set ( $t = "azul") #else #set($t = "azul2") #end
			<tr class="$t">
				<td>$!cexamen</td>
				<td>$!sexamen</td>
			</tr>
		#end
		<tr>
			<td colspan="3"><input class="boton" type="button" value="Cerrar" name="close" onclick="window.close();" style="width:100px"></td>
		</tr>	
	</table>
</form>
