#set ($titlePage = "Consulta de Ordenes Sin Pago" )
#set($ligaDaosOrden = $link.setPage("web2lab,ap,DatosOrden.vm").toString())

<script language="javascript" SRC="$content.getURI("javascript/generales.js")"></script>
<script language="javascript" SRC="$content.getURI("javascript/validacionobjeto/pantallas/OrdenesSinPago.js")"></script>

<script type='text/javascript' src='/web2labportal/dwr/interface/DatosPago.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/engine.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/util.js'></script>


<script>
		 window.onload = init;			    		 
</script>	


<form name="frmOrdenesSinPago" method="post" >		
	<input type="hidden" id="IdSucursalActual" name="IdUnidadActual" value="$data.getSession().getAttribute("idgrupo")">		
	<input type="hidden" id="ligaDatosOrden" name="ligaDatosOrden" value="$!ligaDaosOrden">	
    <input type="hidden" id="idUsuario" name="idUsuario" value="$data.getUser().getId()">			
    <input type="hidden" id="kticketcaja" name="kticketcaja" value="0">			
	<div id="divTimer">
        <table border="0"  align="center" style="width: 883px">
    	    <th>
    	    </th>     
            <tr>
                <td>
        	        <center>
    	    			<input type="button" id="idIniciaTimer" name="idIniciaTimer" value="Inicia Tiempo" onClick="InitializeTimer();" class="boton">
        	         </center>
        	    </td>     	                
                <td>
        	        <center>
    	    			<input type="button" id="idStopTimer" name="idStopTimer" value="Detiene Tiempo" onClick="StopTheClock();" class="boton">
        	         </center>
        	    </td>     	                
                <td>
        	        <center>
    	    			<input type="button" id="idExecute" name="idExecute" value="Ejecuta Consulta" onClick="ejecutaConsulta();" class="boton">
        	         </center>
        	    </td>     	                
                <td>
        	        <center>
                	<select id="selTimer" style="width: 177px" >
    					<option value="5">5 Segundos</option>
    					<option value="10">10 Segundos</option>
    					<option value="20">20 Segundos</option>
    					<option value="30">30 Segundos</option>
    					<option value="60">60 Segundos</option>
    					<option value="180">3 Minutos</option>
    					<option value="300">5 Minutos</option>
    					<option value="480">8 Minutos</option>
    					<option value="600">10 Minutos</option>
    					<option value="900">15 Minutos</option>
    					<option value="1200">20 Minutos</option>
    					<option value="1800">30 Minutos</option>
    				</select>    	    
        	         </center>
        	    </td>     	                
        	</tr>   
        </table>	        
	</div>			
	<div id="divConfirmacionTicket">
        <table border="0"  align="center" style="width: 883px">
    	    <th>
    	    </th>     
            <tr>
                <td>
        	    </td>     	                
                <td>
        	        <center>
    	    			<input type="button" id="idConfirmacionTicket" name="idConfirmacionTicket" value="Atencion Ticket" onClick="AtendidoTicket();" class="boton">
        	         </center>
        	    </td>     	                
                <td>
        	    </td>     	                
                <td>
        	    </td>     	                
        	</tr>   
        </table>	        
	</div>	
	<div id="OrdenesBusqueda">
	</div>	
</form>
