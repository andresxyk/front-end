<SCRIPT language="javaScript" SRC="$content.getURI("javascript/generales.js")"></SCRIPT> 
#set ( $strModo = $CSeguridadTool.getModo() )
#set ( $objGrupo = $CSeguridadTool.getGrupoSistema())
#set ( $strLigaAct = $link.setPage("web2lab,seguridad,GruposSistema.vm"))
#set ( $strLigaAct  = $link.setAction("seguridad.BGrupoSistemaAction").toString())
#set ( $strCargapagina = $link.setAction("seguridad.BGrupoSistemaAction").setPage("web2lab,seguridad,GruposSistema_Form.vm").toString())
#if ($strModo == "modificar")
	#set ($titlePage = "Modifica grupo del sistema")
#elseif ($strModo == "eliminar")
    #set ($titlePage = "Elimina grupo del sistema")
#else
	#set ($strModo = "insertar")
    #set ($titlePage = "Agrega un nuevo grupo del sistema")
#end           
<script language="JavaScript" src="$content.getURI("javascript/seguridad/validaseguridad.js")"></script>
<SCRIPT LANGUAGE ="JavaScript">

	function irAurl() { 
		window.document.frmgruposistema.action = "$strCargapagina";
	}
</script>
	<form method="post" name="frmgruposistema" action="$strLigaAct" onsubmit="return validaVacios('frmgruposistema', 'txtNombre', 'Grupo');">
		<table width="100%" class="tabla">
			<tr>   
				<td>
					#if($!bolCreado == "true")
						<img align="middle" src="$content.getURI('images/icon_alertsml.gif')" alt="Alta de grupo exitosa"/>&nbsp;&nbsp;
						<b><font color="$ff0030">&nbsp; El grupo del sistema: $!strMensaje, se dio de alta con &eacute;xito.</font></b>					
					#elseif($!bolCreado == "false")
						<img align="middle" src="$content.getURI('images/icon_alertsml.gif')" alt="Grupo existente"/>&nbsp;&nbsp;
						<b><font color="$ff0030">&nbsp; El grupo del sistema: $!strMensaje ya existe.</font></b>
					#end
				</td>
			</tr>
		</table>
		<table border="0" cellspacing="2" cellpadding="3" width="100%" class="tabla">
			<tr>
				<th>Nombre del Grupo del sistema</th>
            	<td>
				#if ($strModo != "eliminar")
            		<input type="text" name="txtNombre" value="$!objGrupo.getSsistema()" onKeyUp="cambiaMay('frmgruposistema','txtNombre');">
            		<input type="hidden" name="hdnNombreGrupoAnt" value="$!objGrupo.getSsistema()">
				#else
            		<input type="hidden" name="hdnNombreGrupo" value="$!objGrupo.getSsistema()">
            		$!objGrupo.getSsistema()
				#end
            	</td>
           	</tr>
        </table>
	#if ($strModo == "modificar")
		<input type="submit" name="eventSubmit_doActualiza"  class="boton" value="Actualizar"/>
	#elseif ($strModo == "eliminar")
        <input type="submit" name="eventSubmit_doElimina" class="boton" value="Confirma Eliminar" onClick="return confirm('Confirma eliminar grupo');"/>
	#else
        <input type="submit" name="eventSubmit_doInserta" class="boton" value="Crear" onClick="irAurl()"/>
	#end
	#if($!bolCreado == "true")
		<input type="button"  name="" value="Regresar" class="boton" onClick="location.href='$strLigaAct'">
	#else
    	<input type="button" name="eventSubmit_doCancela" class="boton" value="Cancelar" onClick="location.href='$strLigaAct'"/>     
    #end        
    </form>
