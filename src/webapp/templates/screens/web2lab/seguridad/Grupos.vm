<script language="JavaScript" src="$content.getURI("javascript/seguridad/validaseguridad.js")"></script>  
$page.setTitle("Seguridad: Lista de grupos")   
#set ($strLigaAct = $link.setPage("web2lab,seguridad,Grupos.vm"))
#set ( $strLigaAct  = $link.setAction("seguridad.BGrupoAction").toString())
#set ($strCargaPag = $link.setPage("web2lab,seguridad,Grupos_Form.vm").toString())
#set ($titlePage = "Busqueda de grupos")
