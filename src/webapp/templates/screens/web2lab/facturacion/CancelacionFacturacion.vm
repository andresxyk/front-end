        <tr>
            <td>
                <input type="text" id="txtIdFactura" value="0" STYLE="font-size: 30px;" onKeyPress="numero();" size="10" />
    	    </td> 
    	    <td>
    	    	<select id="selMarca" style="width: 120px" align="up">
						    <option value="1">OLAB</option>
						    <option value="4">AZTECA</option>
