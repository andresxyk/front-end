						   	<option value="7">JENNER PRADO</option>
						   	<option value="8">JENNER LEAN</option>
						   	<option value="19">FAMILYLABS NORTE</option>
						   	<option value="20">EXAKTA</option>
						   	<option value="21">ASESORES DEL SUR</option>
						   	<option value="16">MOREIRA</option>
						   	<option value="22">POLAB</option>
						   	<option value="25">BIOMEDICA DE REFERENCIA</option>
						   	<option value="26">PROMEDIC</option>
			     </select>
    	    </td>    
            <td>
				<select id="selInformacionCopiar" style="width: 200px"> 
					<option value="1">Informacion Facturacion</option>
					<option value="0">Informacion Sucursales</option>
	            </select>								
    	    </td>     			
            <td>
				<input type="button" id="idCancelaFactura" name="idCancelaFactura" value="Cancela Factura" onClick="CancelacionFacturacion();" class="boton">
