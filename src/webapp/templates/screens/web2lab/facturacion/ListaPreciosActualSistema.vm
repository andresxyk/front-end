#set ($titlePage = "Lista de Precios Actual" )

<script language="javascript" SRC="$content.getURI("javascript/generales.js")"></script>
<script language='javascript' src="$content.getURI("javascript/calendarfoco.js")"></script>
<script language='javascript' src="$content.getURI("javascript/calendar.js")"></script>
<script language="javascript" SRC="$content.getURI("javascript/tooljquery/submodal/common.js")"></script>
<script language="javascript" SRC="$content.getURI("javascript/tooljquery/submodal/subModal.js")"></script>
<script language="javascript" SRC="$content.getURI("javascript/validacionobjeto/pantallas/FacturacionPrevio.js")"></script>


<script type='text/javascript' src='/web2labportal/dwr/interface/FacturacionAjax.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/interface/FacturaElectronicaEmpresaAjax.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/interface/BusquedaFacturas.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/engine.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/util.js'></script>

<script>
		 window.onload = init;			    		 
</script>	

#set ($lstConvenios = $CatalogosTool.obtenAll("ConvenioCredito","601"))
#set ($intcSucursal = $data.getSession().getAttribute('idgrupo') )

<form name="frmListaPrecios" method="post" >	
	<input type="hidden" id="idUsuario" name="idUsuario" value="$data.getUser().getId()">	
	<input type="hidden" id="IdSucursalActual" name="IdUnidadActual" value="$data.getSession().getAttribute("idgrupo")">	
    <table	border="0" class="tabla" width="100%">	
    	<tr><th colspan="5">Lista de precios actual</th></tr>
		<tr>
			 <td colspan="2" style="font-weight:  bold; font-size: x-small; color: black; font-style: normal; font-variant: normal">
                Convenio
    	    </td>
			    
		</tr>
		<tr>
			<td colspan="2">
                <select id="selConvenios"  style="width: 600px">
					#foreach($objConvenio in $lstConvenios)
						#option("$!objConvenio.getCconvenio()" "$!objConvenio.getSconvenio()  -  $!objConvenio.getCconvenio()" 0)	
					#end
	            </select>						
    	    </td>	
		</tr>
		<tr>
			 <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
                Busqueda de convenio
    	    </td>    
		</tr>
		<tr>
			<td colspan="9" style="width: 1036px" align="left">
				<input type="text" id="txtBuscarConvenio" onKeyPress="numero();" onkeyup="buscarConvenioRapido(window.document.frmListaPrecios.selConvenios,this.value);" />
			</td>    	    
		</tr>
		<tr>
		</tr>
		<tr>
		<td valign="middle">Tipo de Reporte
				<select id="selTipoReporte" style="width: 120px" align="up">
					    <option value="0">Seleccionar</option>
    					<option value="1">Detalle Examenes</option>
    					<option value="2">Detalle Perfil/Paquetes</option>
		            </select>
			</td>
		</tr>
		<tr>
			<td>
				<input type="button" id="idGenerarDetalle" name="idGenerarDetalle" value="Generar Reporte" onClick="GeneracionListaPreciosActual();" class="boton">				
			</td>	
			<td>
				<input id="prueba" type="button" class="boton" value="Eliminar" onclick="muestraMensaje();">
			</td>		
		</tr>				
		<tr>
		</tr>		
	</table>		
</form>