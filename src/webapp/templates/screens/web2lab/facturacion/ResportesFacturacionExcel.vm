#set ($titlePage = "Reportes Facturacion Mayoreo Excel" )

<script language="javascript" SRC="$content.getURI("javascript/generales.js")"></script>
<script language='javascript' src="$content.getURI("javascript/calendarfoco.js")"></script>
<script language='javascript' src="$content.getURI("javascript/calendar.js")"></script>

<script language="javascript" SRC="$content.getURI("javascript/validacionobjeto/pantallas/ReportesFacturacionExcel.js")"></script>

<script type='text/javascript' src='/web2labportal/dwr/interface/ReportesExcel.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/engine.js'></script>
<script type='text/javascript' src='/web2labportal/dwr/util.js'></script>


<script>
		 window.onload = init;			    		 
</script>	

#set ($lstConvenios = $CatalogosTool.obtenAll("ConvenioCredito","601"))
#set ($lstReportes = $CatalogosTool.obtenAll("ReporteExcelFac","999"))
#set ($intcSucursal = $data.getSession().getAttribute('idgrupo') )

<form name="frmReportesExcel" method="post" >	
	<input type="hidden" id="idUsuario" name="idUsuario" value="$data.getUser().getId()">	
	<input type="hidden" id="IdSucursalActual" name="IdUnidadActual" value="$data.getSession().getAttribute("idgrupo")">	
    <table	border="0" class="tabla" width="100%">	
    	<tr><th colspan="4">Generacion Reporte x Convenio</th></tr>
        <tr>
            <td>
                <select id="selConvenios" style="width: 600px">
					#foreach($objConvenio in $lstConvenios)
						#option("$!objConvenio.getCconvenio()" "$!objConvenio.getSconvenio()  -  $!objConvenio.getCconvenio()" 0)	
					#end
	            </select>						
    	    </td>     
        </tr>   
        <tr>
            <td>
                <select id="selReportes" style="width: 600px">
					#foreach($objReporte in $lstReportes)
						#option("$!objReporte.getCreporteexcelfac()" "$!objReporte.getCreporteexcelfac() - $!objReporte.getSdescripcion()" 0)	
					#end
	            </select>						
    	    </td>     
            <td>
				<input type="button" id="idGenerarReporte" name="idGenerarReporte" value="Generar Reporte" onClick="generarReporteConvenio();" class="boton">
    	    </td>     
        </tr>   
	</table>
	<div id="DireccionFiscal" style="display:none">
	    <table border="0"  align="center" style="width: 883px">	        
            <input type="hidden" id="hdnDatosFiscales" value="0" />
	        <tr>
	    	    <th colspan="6">
	    	        <center>
	    	            <b style="font-weight: bold; font-size: medium; color: black; font-style: normal; font-variant: normal">Datos Fiscales</b>
	    	        </center>
	    	    </th>
	        </tr>   
			<tr>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
					Raz&oacute;n Social
	    	    </td>	            
	            <td colspan="5">
					<input type="text" id="txtRazonSocialFiscal" value="" style="color: black; font-size: x-small; font-weight : bold;" onKeyPress="mayuscula();" onkeyup="consultaDatosFiscalesGrid(window.document.frmConsultaOrden);" size="70" >
					<input type="hidden" id="hdnkDatoFiscal" value="0">
				</td>
			</tr>
			<tr>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
					RFC
	    	    </td>	            
	            <td colspan="5">
					<input type="text" id="txtRFC" value="" style="color: black; font-size: x-small; font-weight : bold;" onKeyPress="mayuscula();validaRFC(window.document.frmConsultaOrden);" onkeyup="consultaDatosFiscalesGrid(window.document.frmConsultaOrden);"  onblur="validaRFC(window.document.frmConsultaOrden);" size="20" maxlength="20" >
				</td>
			</tr>
	        <tr>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
	                Calle
	    	    </td>	            
	            <td colspan="5">
	                <input type="text" id="txtCalleFiscal" style="color: black; font-size: x-small; font-weight : bold;" style="width: 490px" onKeyPress="mayuscula();validaTextos(this.value);"/>
	    	    </td>
	        </tr>   
	        <tr>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
	                Colonia
	    	    </td>
	            <td style="width: 158px">
	                <input type="text" id="txtColoniaFiscal" style="color: black; font-size: x-small; font-weight : bold;" style="width: 157px" onKeyPress="mayuscula();validaTextos(this.value);"/>
	    	    </td>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
	                Delegaci&oacute;n o Municipio
	    	    </td>
	            <td style="width: 158px">
	                <input type="text" id="txtDelegacionMunicipioFiscal" style="color: black; font-size: x-small; font-weight : bold;" style="width: 180px" onKeyPress="mayuscula();validaTextos(this.value);"/>
	    	    </td>
	        </tr>   
	        <tr>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
	                Estado
	    	    </td>
	            <td style="width: 158px">
	                <input type="text" id="txtEstadoFiscal" style="color: black; font-size: x-small; font-weight : bold;" style="width: 180px" onKeyPress="mayuscula();"  />
	    	    </td>
	            <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
	                C&oacute;digo Postal
	    	    </td>
	            <td>
	                <input type="text" id="txtCodigoPostalFiscal" style="color: black; font-size: x-small; font-weight : bold;" onKeyPress="javascript:return numero();"/>
					<input type="hidden" id="hdnCodigoPostalFiscal" value="0">
	    	    </td>
	        </tr>   
	    </table>
	</div>
	<div id="Busqueda">
	</div>
</form>
