#set ($lstGirosClientes = $CatalogosTool.obtenAll("GiroCliente","0"))
<script>
		 window.onload = init;		
</script>	


<form name="frmNotasdeCredito" action="$ligaAct" method="post" >
	<input type="hidden" id="idUsuario" name="idUsuario" value="$data.getUser().getId()">	
	<input type="hidden" id="hdenFacturasNotas" >
	<input type="hidden" id="hdenmontoFactura">
	<input type="hidden" id="hdnCconvenio" >
	<input type="hidden" id="hdenkfacturaporcentaje" name="hdenkfacturaporcentaje">
	<input type="hidden" id="hdenRutaNotaCredito" name="hdenRutaNotaCredito" value="$ligaNotaCredito">
	<input type="hidden" id="hdenRutaFactura" name="hdenRutaPago" value="$ligaActPago">
	<table	border="0" class="tabla" width="100%">	
		<tr><th colspan="5">Generación de Notas de Crédito</th></tr>
		<tr>
			 <td style="font-weight: normal; font-size: x-small; color: black; font-style: normal; font-variant: normal">
                Busqueda de convenio por código
    	    </td>    
    	    <td>
		        <a href="javascript:doNothing()" onclick="javascript:buscarFactura();">
		            <img alt='Buscar - Factura' id="idBuscarFactura" width="30" height="30" border='0' src='$content.getURI('images/icoBuscar.png')' />
		        </a>	
				Factura
    	    </td>
		</tr>
		<tr>
			<td colspan="9" style="width: 1036px" align="left">
				<input type="text" id="txtBuscarConvenio" onKeyPress="mayuscula();" onkeyup="buscarConvenioRapido(window.document.frmNotasdeCredito.selConvenios,this.value);" />
			</td>    	    
		</tr>
		<tr>
			 <td colspan="2" style="font-weight:  bold; font-size: x-small; color: black; font-style: normal; font-variant: normal">
                Convenio
    	    </td>    
		</tr>
		<tr>
			<td colspan="2">
                <select id="selConvenios"  style="width: 600px" onChange="displayCargaDatos();">
					#foreach($objConvenio in $lstConvenios)
						#option("$!objConvenio.getCconvenio()" "$!objConvenio.getSconvenio()  -  $!objConvenio.getCconvenio()" 0)	
					#end
	            </select>						
    	    </td>
			<td>
                <input type="button" id="idLimpiar" value="Limpiar" onClick="limpiaPantalla();" class="boton">
    	    </td>
		</tr>
		<tr>
		</tr>
	</table>
	<div id="gridcargaFacturas" style="display:none"> 
	</div>
</form>

<SCRIPT language="javascript" for=window event=onload>
	document.getElementById("txtBuscarConvenio").focus();
</SCRIPT>	
	
