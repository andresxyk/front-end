#macro (debugReport )
       <div class="h3">
        <h3>SQL Statments</h3>
        <table border="0" cellspacing="2" cellpadding="3" >
    #foreach ( $stm in $debugSQL )
        #if ($t == "a") #set ($t = "b") #else #set ($t = "a") #end
         <tr class="$t"><td>$stm</td></tr>
    #end
        </table>
        <h3>Selected Objects</h3>
        <table border="0" cellspacing="2" cellpadding="3" >
         <tr>
          <th>Object Class</th>
          <th>Primary Key</th>
         </tr>
    #foreach ( $obj in $objs )
        #if ($t == "a") #set ($t = "b") #else #set ($t = "a") #end
         <tr class="$t">
          <td>$obj.getClass().getName()</td>
          <td>$obj.getPrimaryKey()</td>
         </tr>
    #end
        </table>
        <h3>Source Contents</h3>
        <table border="0" cellspacing="2" cellpadding="3" >
         <tr>
    #foreach ( $cname in $sourceColNames )
          <th>$cname</th>
    #end
         </tr>
    #foreach ( $row in $source )
        #if ($t == "a") #set ($t = "b") #else #set ($t = "a") #end
         <tr class="$t">
        #foreach ( $cname in $sourceColNames )
          <td>$row.getString($cname)</td>
        #end
         </tr>
    #end
        </table>
        <h3>Report Data</h3>
        <table border="0" cellspacing="2" cellpadding="3" >
         <tr>
          <th>Type</th>
    #foreach ( $cname in $reportDataColNames )
          <th>$cname</th>
    #end
         </tr>
    #foreach ( $row in $reportData )
        #if ($t == "a") #set ($t = "b") #else #set ($t = "a") #end
         <tr class="$t">
          <td>$row.getRowType()</td>
        #foreach ( $cname in $reportDataColNames )
          <td>$row.getString($cname)</td>
        #end
         </tr>
    #end
         </tr>
        </table>
       </div>
#end

