## Macro que crea control tipo hidden
#macro (formHidden $name $value $extra)
    <input type="hidden" name="$name" value="$!value" $extra>
#end

## Macro que crea una opcion de un componente Select
#macro (option $value $label $select)
    #if("$value" == "$select")
        <option value="$value" selected>$label</option>
    #else
        <option value="$value">$label</option>
    #end
#end

#macro(tab $title $lnk $label $sel)
    #if ($label == $sel)
              <th title="$title"><a href="$lnk">$label</a></th>
    #else
              <td title="$title"><a href="$lnk">$label</a></td>
    #end
#end

#macro(tabEvento $title $lnk $label $sel $evento $onOf $idElemento)
    #if ($label == $sel)
              <th title="$title"><a href="$lnk" onClick="$evento" $onOf id="$idElemento">$label</a></th>
    #else
              <td title="$title"><a href="$lnk" onClick="$evento" $onOf id="$idElemento">$label</a></td>
    #end
#end

#macro (focus $val)
#set ( $focus = $val)
#end

